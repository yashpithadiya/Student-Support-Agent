    {
      "id": "G11_missing_student_id",
      "category": "missing_info",
      "description": "No ID anywhere: the agent must ask, not call the tool or guess.",
      "turns": [
        "What is my current fee status?"
      ],
      "setup_memory": [],
      "fresh_session_between_turns": false,
      "inject_llm_error": null,
      "expect": {
        "prohibited_tools": [
          "check_fee_status"
        ],
        "keywords_any": [
          "student id",
          "your id",
          "id number",
          "student-id",
          "your student"
        ],
        "forbidden_patterns": [
          "450,?000|4,50,000|225,?000"
        ]
      }
    },
    {
      "id": "G12_record_not_found",
      "category": "missing_record",
      "description": "Unknown ID: tool runs, returns not_found, agent reports it honestly.",
      "turns": [
        "Check the fee status for student S9999."
      ],
      "setup_memory": [],
      "fresh_session_between_turns": false,
      "inject_llm_error": null,
      "expect": {
        "required_tools": [
          "check_fee_status"
        ],
        "tool_error_type": "not_found",
        "keywords_any": [
          "not found",
          "no record",
          "couldn't find",
          "could not find",
          "no student",
          "can't find",
          "cannot find",
          "doesn't exist",
          "does not exist",
          "no match",
          "not valid",
          "invalid"
        ],
        "forbidden_patterns": [
          "\\bpaid\\b.*\\b450"
        ]
      }
    },
    {
      "id": "G13_unsupported_policy",
      "category": "unsupported_policy",
      "description": "Handbook has no hostel rules: agent must say so and not invent a time.",
      "turns": [
        "What is the hostel curfew time?"
      ],
      "setup_memory": [],
      "fresh_session_between_turns": false,
      "inject_llm_error": null,
      "expect": {
        "required_tools": [
          "search_policy"
        ],
        "expect_no_chunks": true,
        "keywords_any": [
          "does not contain",
          "not contain",
          "no information",
          "not in the handbook",
          "don't have",
          "do not have",
          "cannot find",
          "can't find",
          "couldn't find",
          "could not find",
          "not covered",
          "no relevant",
          "doesn't contain",
          "isn't covered",
          "not available in"
        ],
        "forbidden_patterns": [
          "\\b\\d{1,2}\\s?(:\\d\\d)?\\s?(pm|am|p\\.m\\.|a\\.m\\.)\\b"
        ]
      }
    },
    {
      "id": "G14_tool_failure",
      "category": "tool_failure",
      "description": "Fee ledger outage for S1009: report the failure; never fabricate fee numbers.",
      "turns": [
