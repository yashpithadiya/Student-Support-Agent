        ],
        "memory_after": {
          "preferred_name": "Ria",
          "programme": "PGDM",
          "course": "AI & DS"
        }
      }
    },
    {
      "id": "G16_memory_recall_new_session",
      "category": "memory_read",
      "description": "Fact stored in an earlier session is recalled without any tool.",
      "turns": [
        "Which course did I tell you I am in?"
      ],
      "setup_memory": [
        {
          "key": "course",
          "value": "BDA"
        }
      ],
      "fresh_session_between_turns": false,
      "inject_llm_error": null,
      "expect": {
        "expect_no_tool": true,
        "keywords_any": [
          "bda"
        ],
        "expected_memory_used": [
          "course"
        ]
      }
    },
