{
  "description": "Golden dataset for the Intelligent Student Support Agent (fictional data). Expected behaviour is defined BEFORE running any evaluation.",
  "cases": [
    {
      "id": "G01_direct_greeting",
      "category": "direct",
      "description": "General question: no tool needed.",
      "turns": [
        "Hello! What can you help me with?"
      ],
      "setup_memory": [],
      "fresh_session_between_turns": false,
      "inject_llm_error": null,
      "expect": {
        "expect_no_tool": true,
        "keywords_any": [
          "fee",
          "scholarship",
          "support",
          "course"
        ]
      }
    },
    {
      "id": "G02_fee_partial",
      "category": "fee_tool",
      "description": "Fee status via tool with ID in the question.",
      "turns": [
        "What is my fee status? My student ID is S1002."
      ],
      "setup_memory": [],
      "fresh_session_between_turns": false,
      "inject_llm_error": null,
      "expect": {
        "required_tools": [
          "check_fee_status"
        ],
        "tool_arguments": [
          {
            "tool": "check_fee_status",
            "arguments": {
              "student_id": "S1002"
            }
          }
        ],
        "expected_numbers": [
          225000
        ],
        "keywords_any": [
          "partially paid",
          "partial"
        ]
      }
    },
    {
      "id": "G03_fee_overdue",
      "category": "fee_tool",
      "description": "Overdue fee status; must not create a ticket unprompted.",
      "turns": [
        "Student ID S1003 - how much fee do I still owe?"
      ],
      "setup_memory": [],
      "fresh_session_between_turns": false,
      "inject_llm_error": null,
      "expect": {
        "required_tools": [
          "check_fee_status"
        ],
        "prohibited_tools": [
          "create_support_request"
        ],
        "expected_numbers": [
          450000
        ],
        "keywords_any": [
          "overdue",
          "due"
        ]
      }
    },
    {
