      "fresh_session_between_turns": false,
      "inject_llm_error": null,
      "expect": {
        "required_tools": [
          "search_policy"
        ],
        "prohibited_tools": [
          "check_fee_status"
        ],
        "expected_chunks": [
          "payment-portal-failure"
        ],
        "keywords_any": [
          "24 hours",
          "next working day"
        ]
      }
    },
