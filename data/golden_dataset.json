          "get_student_record"
        ],
        "keywords_any": [
          "bda"
        ]
      }
    },
    {
      "id": "G07_ticket_draft_needs_confirmation",
      "category": "support_ticket",
      "description": "A ticket request with a stated problem creates only a DRAFT; no ticket exists until the student confirms.",
      "turns": [
        "Please raise a support request for S1003: my fee payment failed twice on the portal."
      ],
      "setup_memory": [],
      "fresh_session_between_turns": false,
      "inject_llm_error": null,
      "expect": {
        "required_tools": [
          "prepare_support_ticket"
        ],
        "prohibited_tools": [
          "create_support_request"
        ],
        "tool_arguments": [
          {
            "tool": "prepare_support_ticket",
            "arguments": {
              "student_id": "S1003",
              "category": "fee"
            }
          }
        ],
        "draft_created_for": "S1003",
        "no_ticket_for": "S1003",
        "keywords_any": [
          "confirm"
        ]
      }
    },
    {
      "id": "G08_policy_portal_failure",
      "category": "policy_rag",
      "description": "Suggested demo question; needs retrieved policy, not a student tool.",
      "turns": [
